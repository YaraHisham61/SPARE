\newlabel{sec:supp-figures}{{7.2}{7}{\hskip -1em.~Supplementary Figures}{subsection.7.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces mIoU vs.\ Gaussian noise level $\sigma $ for the SA-1B (generic prompt) and SACo-Gold (concept prompt) pipelines. Both curves anchor at mIoU,=,1 for the clean baseline and decrease monotonically; SACo-Gold consistently retains higher stability, reflecting the added semantic context of concept prompts.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:supp-degrad-curves}{{2}{7}{mIoU vs.\ Gaussian noise level $\sigma $ for the SA-1B (generic prompt) and SACo-Gold (concept prompt) pipelines. Both curves anchor at mIoU,=,1 for the clean baseline and decrease monotonically; SACo-Gold consistently retains higher stability, reflecting the added semantic context of concept prompts}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-prompt-length mIoU under text degradation. Single-word concepts collapse to near-zero stability at $\ell !=!1$ (one character substituted), while three-or-more-word phrases retain substantial stability at the same noise level. The gap is explained by the effective corruption rate $\eta = \ell /\bar  {c}$: a single substitution corrupts 17characters in a 6-character word but only 6phrase.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:supp-prompt-length}{{3}{7}{Per-prompt-length mIoU under text degradation. Single-word concepts collapse to near-zero stability at $\ell !=!1$ (one character substituted), while three-or-more-word phrases retain substantial stability at the same noise level. The gap is explained by the effective corruption rate $\eta = \ell /\bar {c}$: a single substitution corrupts 17characters in a 6-character word but only 6phrase}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cross-modal comparison of output stability under visual (left) and linguistic (right) degradation in the SACo-Gold pipeline. The y-axis is shared to enable direct comparison: visual mIoU degrades slowly (0.923 at $\sigma !=!10$), while linguistic mIoU collapses sharply (0.323 at $\ell !=!1$), illustrating the asymmetric fragility of the two input modalities.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:supp-cross-modal}{{4}{8}{Cross-modal comparison of output stability under visual (left) and linguistic (right) degradation in the SACo-Gold pipeline. The y-axis is shared to enable direct comparison: visual mIoU degrades slowly (0.923 at $\sigma !=!10$), while linguistic mIoU collapses sharply (0.323 at $\ell !=!1$), illustrating the asymmetric fragility of the two input modalities}{figure.4}{}}
